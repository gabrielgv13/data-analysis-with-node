function tresMenosPop2023(){
    const ordCre = (a, b) => a.pop2023 - b.pop2023;
    const listaPaisesOrd = [...listaPaises]
    listaPaisesOrd.sort(ordCre)

    console.log("Os menos populosos de 2023:");
    for (i = 0; i < 3; i++){
        console.log(`${(i + 1)+"°"} ${listaPaisesOrd[i].country} com ${listaPaisesOrd[i].pop2023} habitantes`);
    }
}
