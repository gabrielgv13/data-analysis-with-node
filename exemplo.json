function maiorPop2050(lista){
    const ordDecr = (a, b) => b.pop2025 - a.pop2025;
    const listaPaisesOrd = [...listaPaises]
    listaPaisesOrd.sort(ordDecr)


    console.log(`${listaPaisesOrd[0].country} com uma estimativa de: ${listaPaisesOrd[0].pop2050} habitantes`);
}
