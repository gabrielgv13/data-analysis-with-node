const { log, table } = require("console");
const { json } = require("stream/consumers");

let jsonString

try{
    const fs = require("fs")
    jsonString = fs.readFileSync(__dirname + "/countries-table.json")
} catch (erro){
    console.log('Ocorreu algum erro ao ler arquivo:', erro);
    return
}

const listaPaises = JSON.parse(jsonString)

function mostrarPaises(lista){
    // Ordenando a lista por ordem alfábetica dos países
    lista.sort((a, b) => a.country.localeCompare(b.country));

    // Só formatando o output no terminal, para ficar simples
    //for (pais of lista){
    //    console.log(`${pais.country}`);
    //}

    console.table(lista.map((x) => `${x.country}  População 2023: ${x.pop2023}`));
}
//mostrarPaises(listaPaises)

function populacaoDecrescente(){
    // Filtrando a lista de paises em ordem crescente conforme o atributo pop2023
    const ordDecr = (a, b) => b.pop2023 - a.pop2023;
    const listaPaisesOrd = [...listaPaises]
    listaPaisesOrd.sort(ordDecr)

    // Só formatando o output no terminal
    /*
    for (pais of listaPaisesOrd){
        if (pais.pop2023){
            console.log(`${pais.country} População de 2023: ${pais.pop2023}`);
        }
        else {
            console.log(`${pais.country} Sem dados de população em 2023`);
        }
    }
    */
   
   console.table(listaPaisesOrd.map((x) => x.pop2023 ? `${x.country}  População 2023: ${x.pop2023}` : `${x.country}  Sem dados de 2023`));
}

//populacaoDecrescente(listaPaises)

function populacaoCrescente(){
    // Filtrando a lista de paises em ordem decrescente conforme o atributo pop2023
    const ordCre = (a, b) => a.pop2023 - b.pop2023;
    const listaPaisesOrd = [...listaPaises]
    listaPaisesOrd.sort(ordCre)
    
    for (pais of listaPaisesOrd){
        if (pais.pop2023){
            console.log(`${pais.country} População de 2023: ${pais.pop2023}`);
        }
        else {
            console.log(`${pais.country} Sem dados de população em 2023`);
        }
    }
}

